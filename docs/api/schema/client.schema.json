        "on"
      ]
    },
    "AbortVoteCommand": {
      "description": "CastAbortVote is a living player's vote to call the game off before it has a winner (audit K1, rules §8b). A later vote by the same player replaces the earlier one, so Yes: false withdraws it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command"
        },
        "args": {
          "$ref": "#/$defs/AbortVoteArgs"
