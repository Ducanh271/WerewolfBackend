          "additionalProperties": false,
          "properties": {
            "announce": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "chiefElection": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "chiefSuccession": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "day": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "defense": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "hunterShot": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "loversMeet": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "nightStep": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "nominationLock": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "phoneCheck": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "roleView": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            },
            "verdict": {
              "type": "integer",
              "maximum": 86400000,
              "minimum": 0
            }
          },
          "required": []
        }
      },
      "required": [
        "timers"
      ]
    },
